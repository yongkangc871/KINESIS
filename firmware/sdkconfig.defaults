# Board: ESP32-WROOM-32 (classic ESP32, 4 MB flash, no PSRAM).
CONFIG_IDF_TARGET="esp32"

# The OLED uses the legacy I2C driver API (works on IDF 5.1+); hide its deprecation notice.
CONFIG_I2C_SUPPRESS_DEPRECATE_WARN=y

# UART0 (USB bridge) carries the binary stream only, so silence the console and logs.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# The Wi-Fi stack makes the app larger than the default 1 MB partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
