# Copy this file to sdkconfig.secrets (git-ignored) and put the real values in it.
# It is applied when firmware/sdkconfig is generated, so delete firmware/sdkconfig after
# changing it (or set the same values with idf.py menuconfig).
CONFIG_WM_WIFI_SSID="WristMonitor"
CONFIG_WM_WIFI_PASSWORD="your-password-here"
